# Every VITE_ value is public. Never place secrets here.
VITE_DATA_MODE=static
# The public calendar relay is the default and needs no secret.
# VITE_GITHUB_CONTRIBUTIONS_SOURCE=public-calendar
# Use github-graphql only when the hosting server supplies GITHUB_TOKEN.
# VITE_GITHUB_CONTRIBUTIONS_SOURCE=github-graphql
# Live mode requires a separately agreed HTTP API.
# VITE_API_BASE_URL=https://api.example.com

# The optional official calendar reads GITHUB_TOKEN from the server process environment only.
# Do not prefix this secret with VITE_ or put it in browser configuration.
