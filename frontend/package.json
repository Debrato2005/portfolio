{
  "name": "portfolio-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixture": "vite --mode fixture",
    "dev:live": "vite --mode live",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && playwright test --config playwright.production.config.ts",
    "build": "npm run typecheck && vite build && node scripts/check-production.mjs",
    "docs:check": "python3 docs/verify_docs.py",
    "skills:check": "python3 scripts/verify_skills.py",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run docs:check && npm run skills:check",
    "browsers:install": "node scripts/install-browsers.mjs",
    "graph:build": "node scripts/graph.mjs build",
    "graph:query": "node scripts/graph.mjs query",
    "browsers:deps": "node scripts/install-browser-libraries.mjs",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4317 --strictPort"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.5",
    "vitest": "5.0.3",
    "qrcode": "1.5.4"
  }
}
